   "source": [
    "#Take the galaxies in one redshift slice and for bins of absolute magnitude fit their restframe G-R colour distribution\n",
    "import numpy as np\n",
    "from scipy.optimize import curve_fit  \n",
    "def gauss(x,mu,sigma,frac):\n",
    "    return (frac/(sigma*np.sqrt(2.0*np.pi)))*np.exp(-(x-mu)**2/(2.0*sigma**2))\n",
    "\n",
    "def bimodal(x,mu1,sigma1,f1,mu2,sigma2):\n",
    "    return gauss(x,mu1,sigma1,f1)+gauss(x,mu2,sigma2,(1.0-f1))\n",
    "\n",
    "def bimodal_colourfit(dat,reg,faint_lim,bright_lim,jzbin,plot=False):\n",
    "    Sel=ca.selection(reg)\n",
    "    zmask=(dat['izbin']==jzbin) & (dat['reg']==reg) & (np.abs(dat['ABSMAG_RP1']>bright_lim)) & (np.abs(dat['ABSMAG_RP1']<faint_lim)) & dat['invollim'] & dat['compl']\n",
    "    data=dat['REST_GMR_0P1'][zmask]\n",
    "    print('Sample size:',zmask.sum())\n",
    "    y,x=np.histogram(data, bins=100, range=None, density=None, weights=None)\n",
    "    x=(x[1:]+x[:-1])/2 #bin centres\n",
    "    dx=x[1]-x[0]\n",
    "    y=y/(sum(y)*dx) #normalize\n",
    "    expected=(0.5,0.3,0.5,0.9,0.1)\n",
    "    params,cov=curve_fit(bimodal,x,y,expected)\n",
    "    sigmas=np.sqrt(np.diag(cov))\n",
    "    for i in range (sigmas.size):  \n",
    "         if (sigmas[i]>1.0e+10): \n",
    "             print('sigmas[',i,']=inf reset')\n",
    "             sigmas[i]=10.0\n",
    "         if (sigmas[i]<0.0): \n",
    "             print('sigmas[',i,']<0 reset')\n",
    "             sigmas[i]=10.0\n",
    "         if (sigmas[i]<0.0): \n",
    "             print('params[',i,']<0 reset')\n",
    "             params[i]=10.0\n",
    "    if (plot):\n",
    "        plt.plot(x,y,color='black',lw=3,label='data')\n",
    "        plt.plot(x,bimodal(x,*params),color=Sel['col'],lw=3,label='model')\n",
    "        plt.legend()\n",
    "        plt.show()\n",
    "        print('parameters:',params,'\\n','   errors:',sigmas)    \n",
    "    return params,sigmas\n",
    "\n",
    "\n",
    "zbins=(zbin_edges[1:]+zbin_edges[:-1])/2.0\n",
    "# Dummy arrays to store the redshift dependence of the parameters in each magnitude bin\n",
    "nbins=3\n",
    "mublueS=np.zeros((nbins,zbin_edges.size-1))\n",
    "mublue_errS=np.zeros((nbins,zbin_edges.size-1))\n",
    "muredS=np.zeros((nbins,zbin_edges.size-1))\n",
    "mured_errS=np.zeros((nbins,zbin_edges.size-1))\n",
    "sigblueS=np.zeros((nbins,zbin_edges.size-1))\n",
    "sigblue_errS=np.zeros((nbins,zbin_edges.size-1))\n",
    "sigredS=np.zeros((nbins,zbin_edges.size-1))\n",
    "sigred_errS=np.zeros((nbins,zbin_edges.size-1))\n",
    "fracblueS=np.zeros((nbins,zbin_edges.size-1))\n",
    "fracblue_errS=np.zeros((nbins,zbin_edges.size-1))\n",
    "magS=np.zeros((nbins,zbin_edges.size-1))\n",
    "\n",
    "mublueN=np.zeros((nbins,zbin_edges.size-1))\n",
    "mublue_errN=np.zeros((nbins,zbin_edges.size-1))\n",
    "muredN=np.zeros((nbins,zbin_edges.size-1))\n",
    "mured_errN=np.zeros((nbins,zbin_edges.size-1))\n",
    "sigblueN=np.zeros((nbins,zbin_edges.size-1))\n",
    "sigblue_errN=np.zeros((nbins,zbin_edges.size-1))\n",
    "sigredN=np.zeros((nbins,zbin_edges.size-1))\n",
    "sigred_errN=np.zeros((nbins,zbin_edges.size-1))\n",
    "fracblueN=np.zeros((nbins,zbin_edges.size-1))\n",
    "fracblue_errN=np.zeros((nbins,zbin_edges.size-1))\n",
    "magN=np.zeros((nbins,zbin_edges.size-1))\n",
    "zcen=(zbin_edges[1:]+zbin_edges[:-1])/2.0\n",
    "\n",
    "for jzbin in range (zbin_edges.size-1):\n",
    "    ireg=-1\n",
    "    print('zbins:',zbins[jzbin])\n",
    "    for reg in (regions):\n",
    "        ireg+=1\n",
    "        faint=faint_bound[ireg,jzbin]\n",
    "        bright=np.maximum(-23.0,bright_bound[ireg,jzbin])\n",
    "        print('reg=',reg,' mag range:',faint,bright)\n",
    "        zmask=(dat['izbin']==jzbin) & (dat['reg']==reg) &  dat['invollim'] & dat['compl']\n",
    "\n",
    "        percentiles= np.linspace(0, 100.0, nbins+1)\n",
    "        magbin_edges= np.percentile(dat['ABSMAG_RP1'][zmask], percentiles)\n",
    "\n",
    "        magbin_cen=(magbin_edges[1:]+magbin_edges[:-1])/2.0\n",
    "        print('magbin_cen:',magbin_cen)\n",
    "        for imag in range (magbin_cen.size):\n",
    "          faint_lim=magbin_edges[imag+1]\n",
    "          bright_lim=magbin_edges[imag]\n",
    "\n",
    "          if (reg=='S'): \n",
    "            paramsS,sigmaS=bimodal_colourfit(dat,reg,faint_lim,bright_lim,jzbin=jzbin,plot=False)         \n",
    "            mublueS[imag,jzbin]=paramsS[0]\n",
    "            mublue_errS[imag,jzbin]=sigmaS[0]\n",
    "            sigblueS[imag,jzbin]=paramsS[1]\n",
    "            sigblue_errS[imag,jzbin]=sigmaS[1]\n",
    "            fracblueS[imag,jzbin]=paramsS[2]\n",
    "            fracblue_errS[imag,jzbin]=sigmaS[2]\n",
    "            muredS[imag,jzbin]=paramsS[3]\n",
    "            mured_errS[imag,jzbin]=sigmaS[3]\n",
    "            sigredS[imag,jzbin]=paramsS[4]\n",
    "            sigred_errS[imag,jzbin]=sigmaS[4]     \n",
    "            magS[imag,jzbin]=magbin_cen[imag]\n",
    "          if (reg=='N'): \n",
    "            paramsN,sigmaN=bimodal_colourfit(dat,reg,faint_lim,bright_lim,jzbin=jzbin,plot=False)         \n",
    "            mublueN[imag,jzbin]=paramsN[0]\n",
    "            mublue_errN[imag,jzbin]=sigmaN[0]\n",
    "            sigblueN[imag,jzbin]=paramsN[1]\n",
    "            sigblue_errN[imag,jzbin]=sigmaN[1]\n",
    "            fracblueN[imag,jzbin]=paramsN[2]\n",
    "            fracblue_errN[imag,jzbin]=sigmaN[2]\n",
    "            muredN[imag,jzbin]=paramsN[3]\n",
    "            mured_errN[imag,jzbin]=sigmaN[3]\n",
    "            sigredN[imag,jzbin]=paramsN[4]\n",
    "            sigred_errN[imag,jzbin]=sigmaN[4]\n",
    "            magN[imag,jzbin]=magbin_cen[imag]\n",
    "\n",
    "\n",
    "          \n",
    "\n",
    "zoff=0.002\n",
    "for imag in range (magbin_cen.size):\n",
    "\n",
    "    plt.errorbar(zbins-zoff,mublueS[imag,:],np.abs(sigblueS[imag,:]),ecolor='cyan',color='blue')\n",
    "    plt.errorbar(zbins-zoff,mublueS[imag,:],np.abs(mublue_errS[imag,:]),ecolor='blue',color='blue',label='$\\mu_{blue}$ S')\n",
    "    plt.errorbar(zbins-zoff,muredS[imag,:],np.abs(sigredS[imag,:]),ecolor='orange',color='red')\n",
    "    plt.errorbar(zbins-zoff,muredS[imag,:],np.abs(mured_errS[imag,:]),ecolor='red',color='red',label='$\\mu_{red}$ S')\n",
    "    plt.errorbar(zbins-zoff,fracblueS[imag,:],np.abs(fracblue_errS[imag,:]),ecolor='green',color='green',label='frac$_{blue}$ S')\n",
    "\n",
    "    plt.errorbar(zbins+zoff,mublueN[imag,:],np.abs(sigblueN[imag,:]),ecolor='cyan',color='blue',linestyle='dashed')\n",
    "    plt.errorbar(zbins+zoff,mublueN[imag,:],np.abs(mublue_errN[imag,:]),ecolor='blue',color='blue',label='$\\mu_{blue}$ S',linestyle='dashed')\n",
    "    plt.errorbar(zbins+zoff,muredN[imag,:],np.abs(sigredN[imag,:]),ecolor='orange',color='red',linestyle='dashed')\n",
    "    plt.errorbar(zbins+zoff,muredN[imag,:],np.abs(mured_errN[imag,:]),ecolor='red',color='red',label='$\\mu_{red}$ S',linestyle='dashed')\n",
    "    plt.errorbar(zbins+zoff,fracblueN[imag,:],np.abs(fracblue_errN[imag,:]),ecolor='green',color='green',label='frac$_{blue}$ S',linestyle='dashed')\n",
    "\n",
    "plt.ylim(0.0,1.2)\n",
    "plt.xlabel('z')\n",
    "plt.ylabel('$\\mu, frac$')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
