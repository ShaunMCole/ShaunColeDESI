   "source": [
    "# I now want to fit the variation of each parameter with both magnitude and redshift\n",
    "\n",
    "def surface_func2(XY, a, b, c, d, e, f): #polynomial surface x is redshift and y magnitude\n",
    "    x, y = XY\n",
    "    return a + b*x + c*y + d*x*y + e*x**2 + f*y**2\n",
    "\n",
    "def surface_func(XY, a, b, c, d, e, f, g , h , i ,j): #polynomial surface x is redshift and y magnitude\n",
    "    x, y = XY\n",
    "    return a + b*x + c*y + d*x*y + e*x**2 + f*y**2 +g*x*y**2 + h*(x**2)*y +i*x**3 + j*y**3\n",
    "\n",
    "\n",
    "y=magN.ravel() #bin centre abs magnitude for each magnitude slice at each redhsift  (flattened to a 1D array)\n",
    "x2d=np.row_stack((zbins,zbins,zbins))\n",
    "x=x2d.ravel() # flattened to a 1D array\n",
    "XY= (x,y) # pack into a tuple to supply to the fitting function \n",
    "\n",
    "\n",
    "z=mublueN.ravel()          #unwrapped 1D views of the arrays of values we want to fit\n",
    "sigma_z=mublue_errN.ravel()#and their errors\n",
    "# x, y, z are your data points; sigma_z are the errors on z\n",
    "popt_blue, pcov_blue = curve_fit(surface_func, (x, y), z, sigma=sigma_z, absolute_sigma=True)\n",
    "\n",
    "z=muredN.ravel()          #unwrapped 1D views of the arrays of values we want to fit\n",
    "sigma_z=mured_errN.ravel()#and their errors\n",
    "# x, y, z are your data points; sigma_z are the errors on z\n",
    "popt_red, pcov_red = curve_fit(surface_func, (x, y), z, sigma=sigma_z, absolute_sigma=True)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "print('popt_blue:',popt_blue)\n",
    "\n",
    "print('popt_red:',popt_red)\n",
    "\n"
   ]
  },
