    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Best-fit parameters:\n",
      "a = 20740.5944 ± 325.8530\n",
      "b = -30027.7882 ± 715.7831\n",
      "c = 22.3562 ± 0.2724\n",
      "alpha = -4.6473 ± 0.1136\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "chi-squared per dof: 3.9479232169551044\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Assign overdensity to each galaxy based on overdensity in a redshift shell compared to smooth fit\n",
    "# First plot dn/dz with jackknife errors\n",
    "dndzN,dndzN_err,zbinN=ca.plot_dndz(dat,'N')\n",
    "dndzS,dndzS_err,zbinS=ca.plot_dndz(dat,'S')\n",
    "dndz=np.concatenate((dndzN, dndzS))\n",
    "dndz_err=np.concatenate((dndzN_err, dndzS_err))\n",
    "zbin=np.concatenate((zbinN, zbinS))\n",
    "\n",
    "#Sort into increasing z value\n",
    "sorted_indices = np.argsort(zbin)\n",
    "dndz_sorted = dndz[sorted_indices]\n",
    "dndz_err_sorted= dndz_err[sorted_indices]\n",
    "zbin_sorted = zbin[sorted_indices]\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.optimize import curve_fit\n",
    "\n",
    "# 1. Define the model dndz(z) function\n",
    "def model_dndz(z, a, b, c, alpha):\n",
    "    return (a * z + b * z**2 ) * np.exp(-alpha * z -c * z**2)\n",
    "\n",
    "# 2. Fit the model to the data\n",
    "popt, pcov = curve_fit(\n",
    "    model_dndz,\n",
    "    zbin_sorted,\n",
    "    dndz_sorted,\n",
    "    sigma=dndz_err_sorted,\n",
    "    absolute_sigma=True  # Use true uncertainties\n",
    ")\n",
    "\n",
    "# 3. Extract best-fit parameters and uncertainties\n",
    "a_fit, b_fit, c_fit, alpha_fit = popt\n",
    "a_err, b_err, c_err, alpha_err = np.sqrt(np.diag(pcov))\n",
    "\n",
    "print(f\"Best-fit parameters:\")\n",
    "print(f\"a = {a_fit:.4f} ± {a_err:.4f}\")\n",
    "print(f\"b = {b_fit:.4f} ± {b_err:.4f}\")\n",
    "print(f\"c = {c_fit:.4f} ± {c_err:.4f}\")\n",
    "print(f\"alpha = {alpha_fit:.4f} ± {alpha_err:.4f}\")\n",
    "\n",
    "# 4. Plot the fit\n",
    "dndz_fit = model_dndz(zbin_sorted, *popt)\n",
    "\n",
    "plt.errorbar(zbin_sorted, dndz_sorted, yerr=dndz_err_sorted, fmt='o', label='Data')\n",
    "plt.plot(zbin_sorted, dndz_fit, label='Best Fit')\n",
    "plt.xlabel('z')\n",
    "plt.ylabel('dN/dz')\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "#compute chi-squared/dof\n",
    "chisquared_dof=np.sum(((dndz_sorted-dndz_fit)/dndz_err_sorted)**2)/(dndz_sorted.size-4)\n",
    "print('chi-squared per dof:',chisquared_dof) \n",
    "\n",
    "# Assign overdensity to each galaxy based on tabulated dn/dz and the smooth fit\n",
    "overdensityS=dndzS/model_dndz(zbinS, a_fit, b_fit, c_fit, alpha_fit)\n",
    "overdensityN=dndzN/model_dndz(zbinN, a_fit, b_fit, c_fit, alpha_fit)\n",
    "\n",
    "plt.plot(zbinS, overdensityS, marker='.', label='S',color='red')\n",
    "plt.plot(zbinN, overdensityN, marker='.', label='N',color='blue')\n",
    "\n",
    "\n",
    "# interpolate to the redshift of each galaxy\n",
    "regmask=(dat['reg']=='S')\n",
    "dat['overdensity'][regmask]=np.interp(dat['Z'][regmask],zbinS,overdensityS)\n",
    "plt.scatter(dat['Z'][regmask],dat['overdensity'][regmask],marker='.',lw=0,s=20,color='red')\n",
    "regmask=(dat['reg']=='N')\n",
    "dat['overdensity'][regmask]=np.interp(dat['Z'][regmask],zbinN,overdensityN)\n",
    "plt.scatter(dat['Z'][regmask],dat['overdensity'][regmask],marker='.',lw=0,s=20,color='blue')\n",
    "\n",
    "plt.xlabel('z')\n",
    "plt.ylabel('Overdensity')\n",
    "plt.legend()\n",
    "plt.show()\n"
   ]
  },
